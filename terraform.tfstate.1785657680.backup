                                          "description": "Allow overriding the automatically determined minimum TSC frequency of the cluster\nand fixate the minimum to this frequency.",
                                          "format": "int64",
                                          "type": "integer"
                                        },
                                        "minimumReservePVCBytes": {
                                          "description": "MinimumReservePVCBytes is the amount of space, in bytes, to leave unused on disks.\nDefaults to 131072 (128KiB)",
                                          "format": "int64",
                                          "type": "integer"
                                        },
