                                              "type": "integer"
                                            }
                                          },
                                          "type": "object"
                                        },
                                        "memoryOvercommit": {
                                          "description": "MemoryOvercommit is the percentage of memory we want to give VMIs compared to the amount\ngiven to its parent pod (virt-launcher). For example, a value of 102 means the VMI will\n\"see\" 2% more memory than its parent pod. Values under 100 are effectively \"undercommits\".\nOvercommits can lead to memory exhaustion, which in turn can lead to crashes. Use carefully.\nDefaults to 100",
                                          "type": "integer"
